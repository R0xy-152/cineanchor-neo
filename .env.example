# CineAnchor V0.1 Environment Configuration
# Copy this file to .env and adjust paths for your machine.

# Blender headless executable (required)
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe

# FFmpeg executable (required)
FFMPEG_PATH=E:\cineanchor\.tools\ffmpeg\ffmpeg-8.1.1-essentials_build\bin\ffmpeg.exe

# Storage directory for runtime data: assets, renders, exports, projects, logs
# Default: ./storage (relative to repo root)
# STORAGE_DIR=storage

# Server host and port
# CINEANCHOR_HOST=127.0.0.1
# CINEANCHOR_PORT=8000

# Render timeout in seconds (default 900 = 15 min)
# CINEANCHOR_RENDER_TIMEOUT_SECONDS=900

# Sample assets for golden path testing (optional)
# CINEANCHOR_SAMPLE_PNG=samples/assets/hero.png
# CINEANCHOR_SAMPLE_GLB=samples/assets/model.glb
